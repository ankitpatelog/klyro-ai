DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://localhost:6379/0
# Use false only for local HTTP development; keep true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to send credentialed cookies.
CORS_ORIGINS=http://localhost:3000
# Keep this key on the backend only; never expose it to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=knowledge-files

QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=knowledge_chunks
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=YOUR_EMBEDDING_PROVIDER_API_KEY
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
GROQ_API_KEY=your_groq_api_key
GENERATION_API_URL=https://api.groq.com/openai/v1
GENERATION_MODEL=openai/gpt-oss-20b
# LiteLLM routes generation to the primary model and retries/falls back on transient failures.
LITELLM_PRIMARY_MODEL=groq/openai/gpt-oss-20b
LITELLM_FALLBACK_MODELS=groq/qwen/qwen3.8-27b
LITELLM_NUM_RETRIES=1
LITELLM_TIMEOUT_SECONDS=90
LITELLM_COOLDOWN_SECONDS=30
# NVIDIA NeMo Guardrails checks every RAG input and generated answer. Leave the
# key blank to use the built-in conservative fallback rules until you create one.
NVIDIA_API_KEY=your_nvidia_api_key
NEMO_GUARDRAILS_ENABLED=true
NEMO_GUARDRAILS_CONFIG_PATH=app/guardrails
RAG_USER_REQUESTS_PER_MINUTE=10
RAG_GENERATION_MAX_RETRIES=2
RAG_CIRCUIT_BREAKER_SECONDS=30
