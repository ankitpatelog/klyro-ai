NEON_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://localhost:6379/0
# Use false only for local HTTP development; keep true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Comma-separated browser origins allowed to send credentialed cookies.
CORS_ORIGINS=http://localhost:3000
